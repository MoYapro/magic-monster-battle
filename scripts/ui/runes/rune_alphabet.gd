static func has_glyph(letter: String) -> bool:
	return GLYPHS.has(letter)


static func glyph(letter: String) -> Array[PackedVector2Array]:
	var lines: Array[PackedVector2Array] = []
	for flat: Array in GLYPHS.get(letter, []):
		var line := PackedVector2Array()
		for i in range(0, flat.size(), 2):
			line.append(Vector2(flat[i], flat[i + 1]))
		lines.append(line)
	return lines
